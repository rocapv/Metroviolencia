[Unit]
Description=Metroviolencia · API + frontend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roca
WorkingDirectory=/home/roca/Metroviolencia
# Solo localhost: el acceso LAN llega por Apache (/metroviolencia), nunca directo a :8770
ExecStart=/home/roca/Metroviolencia/.venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8770 --root-path /metroviolencia
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
