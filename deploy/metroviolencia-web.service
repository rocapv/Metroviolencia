[Unit]
Description=Metroviolencia · API + frontend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roca
WorkingDirectory=/home/roca/Metroviolencia
ExecStart=/home/roca/Metroviolencia/.venv/bin/python -m uvicorn backend.api:app --host 0.0.0.0 --port 8770
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
